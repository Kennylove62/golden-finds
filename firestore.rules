rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn()
          && request.auth.uid == userId;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isClient() {
      return signedIn()
          && currentUser().data.role == 'client';
    }

    function isSeller() {
      return signedIn()
          && currentUser().data.role == 'seller';
    }

    function orderAfter(orderId) {
      return getAfter(
        /databases/$(database)/documents/orders/$(orderId)
      );
    }

    match /users/{userId} {
      allow create: if ownsUser(userId)
          && request.resource.data.uid == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role in ['client', 'seller'];

      allow read: if ownsUser(userId);

      allow update: if ownsUser(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email;

      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;

      allow create: if isSeller()
          && request.resource.data.name is string
          && request.resource.data.slug is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.slug.size() >= 1;

      allow update: if false;
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.isActive == true
          || (
            isSeller()
            && resource.data.sellerId == request.auth.uid
          );

      allow create: if isSeller()
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 5
          && request.resource.data.price is number
          && request.resource.data.price > 0
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.currency in ['BIF', 'USD', 'EUR']
          && request.resource.data.categoryId is string
          && request.resource.data.categoryName is string
          && request.resource.data.imageBase64 is string
          && request.resource.data.imageBase64 == ''
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() > 10
          && request.resource.data.sellerName is string
          && request.resource.data.sellerWhatsapp is string
          && request.resource.data.isActive == true;

      allow update: if isSeller()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && (
            (
              request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    'stock',
                    'updatedAt'
                  ])
              && request.resource.data.stock is int
              && request.resource.data.stock >= 0
            )
            ||
            (
              request.resource.data.price is number
              && request.resource.data.price > 0
              && request.resource.data.stock is int
              && request.resource.data.stock >= 0
              && request.resource.data.currency in ['BIF', 'USD', 'EUR']
              && request.resource.data.imageBase64 is string
              && request.resource.data.imageBase64 == ''
              && request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.size() > 10
            )
          );

      allow delete: if isSeller()
          && resource.data.sellerId == request.auth.uid;
    }

    match /carts/{userId} {
      allow read: if ownsUser(userId);

      allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasOnly([
            'items',
            'updatedAt'
          ])
          && request.resource.data.items is map;

      allow delete: if ownsUser(userId);
    }

    match /favorites/{userId} {
      allow read: if ownsUser(userId);

      allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasOnly([
            'productIds',
            'updatedAt'
          ])
          && request.resource.data.productIds is list
          && request.resource.data.productIds.size() <= 500;

      allow delete: if ownsUser(userId);
    }

    match /orders/{orderId} {
      allow create: if isClient()
          && request.resource.data.keys().hasOnly([
            'clientId',
            'clientName',
            'clientPhone',
            'sellerId',
            'sellerName',
            'sellerWhatsapp',
            'status',
            'items',
            'totals',
            'subtotal',
            'deliveryFee',
            'total',
            'currency',
            'deliveryOption',
            'deliveryLocation',
            'deliveryPhone',
            'deliveryNotes',
            'paymentMethod',
            'paymentStatus',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.clientId == request.auth.uid
          && request.resource.data.clientName is string
          && request.resource.data.clientPhone is string
          && request.resource.data.sellerId is string
          && request.resource.data.sellerId.size() > 0
          && request.resource.data.sellerName is string
          && request.resource.data.sellerWhatsapp is string
          && request.resource.data.status == 'pending'
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 50
          && request.resource.data.totals is map
          && request.resource.data.subtotal is number
          && request.resource.data.subtotal >= 0
          && request.resource.data.deliveryFee is number
          && request.resource.data.deliveryFee >= 0
          && request.resource.data.total is number
          && request.resource.data.total >= request.resource.data.subtotal
          && request.resource.data.currency in ['BIF', 'USD', 'EUR']
          && request.resource.data.deliveryOption in ['delivery', 'pickup']
          && request.resource.data.deliveryLocation is string
          && request.resource.data.deliveryPhone is string
          && request.resource.data.deliveryNotes is string
          && request.resource.data.paymentMethod
              in ['mobile_money', 'bank_card']
          && request.resource.data.paymentStatus == 'paid'
          && (
            (
              request.resource.data.deliveryOption == 'delivery'
              && request.resource.data.deliveryLocation.size() >= 3
              && request.resource.data.deliveryPhone.size() >= 5
              && request.resource.data.deliveryFee > 0
            )
            ||
            (
              request.resource.data.deliveryOption == 'pickup'
              && request.resource.data.deliveryFee == 0
            )
          );

      allow read: if signedIn()
          && (
            resource.data.clientId == request.auth.uid
            ||
            (
              isSeller()
              && resource.data.sellerId == request.auth.uid
            )
          );

      allow update: if isSeller()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'updatedAt'
              ])
          && (
            (
              resource.data.status == 'pending'
              && request.resource.data.status
                  in ['accepted', 'cancelled']
            )
            ||
            (
              resource.data.status == 'accepted'
              && request.resource.data.status == 'completed'
            )
          );

      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'recipientId',
            'senderId',
            'type',
            'title',
            'message',
            'orderId',
            'read',
            'createdAt'
          ])
          && request.resource.data.recipientId is string
          && request.resource.data.recipientId.size() > 0
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in [
            'new_order',
            'order_accepted',
            'order_cancelled',
            'order_completed'
          ]
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 500
          && request.resource.data.orderId is string
          && request.resource.data.orderId.size() > 0
          && request.resource.data.read == false
          && (
            (
              request.resource.data.type == 'new_order'
              && isClient()
              && orderAfter(
                request.resource.data.orderId
              ).data.clientId == request.auth.uid
              && orderAfter(
                request.resource.data.orderId
              ).data.sellerId == request.resource.data.recipientId
              && orderAfter(
                request.resource.data.orderId
              ).data.status == 'pending'
            )
            ||
            (
              request.resource.data.type == 'order_accepted'
              && isSeller()
              && orderAfter(
                request.resource.data.orderId
              ).data.sellerId == request.auth.uid
              && orderAfter(
                request.resource.data.orderId
              ).data.clientId == request.resource.data.recipientId
              && orderAfter(
                request.resource.data.orderId
              ).data.status == 'accepted'
            )
            ||
            (
              request.resource.data.type == 'order_cancelled'
              && isSeller()
              && orderAfter(
                request.resource.data.orderId
              ).data.sellerId == request.auth.uid
              && orderAfter(
                request.resource.data.orderId
              ).data.clientId == request.resource.data.recipientId
              && orderAfter(
                request.resource.data.orderId
              ).data.status == 'cancelled'
            )
            ||
            (
              request.resource.data.type == 'order_completed'
              && isSeller()
              && orderAfter(
                request.resource.data.orderId
              ).data.sellerId == request.auth.uid
              && orderAfter(
                request.resource.data.orderId
              ).data.clientId == request.resource.data.recipientId
              && orderAfter(
                request.resource.data.orderId
              ).data.status == 'completed'
            )
          );

      allow read: if signedIn()
          && resource.data.recipientId == request.auth.uid;

      allow update: if signedIn()
          && resource.data.recipientId == request.auth.uid
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'read'
              ])
          && request.resource.data.read == true;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
